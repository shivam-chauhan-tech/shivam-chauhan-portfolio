# EmailJS Configuration
# Get these values from https://www.emailjs.com/
# 1. Sign up for a free account
# 2. Create an email service
# 3. Create an email template
# 4. Copy the Service ID, Template ID, and Public Key below

VITE_EMAILJS_SERVICE_ID=your_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# Google reCAPTCHA v3
# 1. Create keys at https://www.google.com/recaptcha/admin (choose reCAPTCHA v3)
# 2. Add VITE_RECAPTCHA_SITE_KEY here (client-side, bundled in build)
# 3. Add RECAPTCHA_SECRET_KEY in Vercel project settings (server-only, never commit)
# 4. Optional: RECAPTCHA_MIN_SCORE=0.5 (default) — lower = stricter bot filtering

VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
